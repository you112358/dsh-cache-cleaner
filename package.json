{
  "name": "dsh-cache-cleaner",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "扫描并清理 DeepSeek Harness 本体、桌面客户端与各插件可重建的缓存，释放磁盘占用，不改动会话、附件与插件安装。",
  "license": "MIT",
  "author": "you112358",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/you112358/dsh-cache-cleaner.git"
  },
  "homepage": "https://github.com/you112358/dsh-cache-cleaner#readme",
  "bugs": {
    "url": "https://github.com/you112358/dsh-cache-cleaner/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cache",
    "cleaner",
    "disk-space",
    "electron"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./assets/icon.svg",
  "scripts": {
    "check": "node scripts/check-client.mjs"
  },
  "files": [
    "lib/**/*.js",
    "client/client.js",
    "assets/icon.svg",
    "assets/icon-180.png",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  }
}
